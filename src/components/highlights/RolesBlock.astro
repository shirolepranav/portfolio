---
// kind "roles": one row per job with dates, title, employer and results.
import type { RolesSection } from "../../content/types.ts";
import Block from "./Block.astro";
import SectionHead from "./SectionHead.astro";

interface Props { section: RolesSection; number: string }
const { section, number } = Astro.props;
---
<Block id={section.id}>
  <SectionHead number={number} label={section.label} title={section.title} />
  <div class="rows">
    {section.items.map((r) => (
      <article>
        <span class="label dates">{r.start} – {r.end}</span>
        <div class="who">
          <h3>{r.title}</h3>
          <span>{[r.employer, r.city].filter(Boolean).join(", ")}</span>
        </div>
        <ul>{r.results.map((x) => <li>{x}</li>)}</ul>
      </article>
    ))}
  </div>
</Block>

<style>
  .rows { display: flex; flex-direction: column; border-bottom: 1px solid var(--line); }
  article { display: flex; flex-wrap: wrap; gap: 12px 32px; padding: 28px 0; border-top: 1px solid var(--line); }
  .dates { flex: 0 0 180px; padding-top: 6px; font-size: 12px; letter-spacing: 0.12em; color: var(--slate); }
  .who { flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  h3 { margin: 0; font-size: clamp(22px, 2cqw, 28px); line-height: 1.15; font-weight: 600; }
  .who span { font-size: 16px; color: var(--slate); }
  ul { flex: 2 1 420px; min-width: 0; margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-size: 16px; line-height: 1.5; }
</style>
