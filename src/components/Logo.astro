---
// The logo mark: a ring (the lake loop) with a dot on its upper right (the hiker).
interface Props { size?: number }
const { size = 22 } = Astro.props;
---
<svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8" /><circle cx="18.2" cy="7" r="2.6" fill="currentColor" stroke="none" /></svg>
