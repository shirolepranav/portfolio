---
// A full-bleed still that fills its parent: the portrait frame on portrait screens, the wide frame on landscape.
// Astro's <Picture> has no art direction, so the <source media> tags are built here with getImage().
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props { phone: ImageMetadata; desktop: ImageMetadata; alt: string; eager?: boolean }
const { phone, desktop, alt, eager = false } = Astro.props;

// `sizes` allows for object-fit: cover, which can draw the frame wider than the screen.
const frames = [
  { img: desktop, media: "(orientation: landscape)", widths: [960, 1440, 2160], sizes: "max(100vw, 160vh)" },
  { img: phone, media: undefined, widths: [390, 780], sizes: "max(100vw, 46vh)" },
];
const sources = await Promise.all(
  frames.flatMap((f) =>
    (["avif", "webp"] as const).map(async (format) => ({
      media: f.media,
      sizes: f.sizes,
      type: `image/${format}`,
      srcset: (await getImage({ src: f.img, format, widths: f.widths })).srcSet.attribute,
    })),
  ),
);
const fallback = await getImage({ src: phone, format: "jpg", widths: frames[1].widths });
---
<picture>
  {sources.map((s) => <source {...s} />)}
  <img
    src={fallback.src}
    srcset={fallback.srcSet.attribute}
    sizes={frames[1].sizes}
    width={phone.width}
    height={phone.height}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding="async"
  />
</picture>

<style>
  picture { position: absolute; inset: 0; }
  img { width: 100%; height: 100%; max-width: none; object-fit: cover; }
</style>
