---
// The lake: the 3D world full screen, walked with wheel, touch and keys, with the HUD over it.
// While the world loads, the walking still shows with a slim progress line (PLAN.md, Loading and fallbacks).
// The landing renders the same shell and dives into it; this page is for a direct visit or a reload.
import Base from "../layouts/Base.astro";
import Lake from "../components/lake/Lake.astro";
import { site } from "../content/site.ts";

const { profile, ui } = site;
---
<Base title={`${profile.name} · ${ui.landingWalk}`} description={profile.tagline}>
  <main><Lake /></main>
</Base>

<script>
  import { startLake } from "../ui/lake.ts";
  void startLake();
</script>
