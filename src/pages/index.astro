---
// Landing: the island as a still, two ways in, a day and night toggle and (on desktop) a sound button.
// The live 3D island loads after the page and fades in over the still; "Walk the lake" dives into the lake on the
// same canvas (src/ui/landing.ts). Every word comes from src/content/site.ts.
import Base from "../layouts/Base.astro";
import Landing from "../components/Landing.astro";
import IslandStill from "../components/IslandStill.astro";
import Lake from "../components/lake/Lake.astro";
import { site } from "../content/site.ts";

const { profile } = site;
---
<Base title={`${profile.name} · ${profile.role}`} description={profile.tagline} path="/">
  <Landing page="landing" />
  <Lake landing><IslandStill eager /></Lake>
</Base>

<script>
  // The 3D waits for the page to finish loading, then starts on the visitor's first move, touch, scroll or key press,
  // or after 3 s idle, whichever comes first. So it never competes with the text, buttons and still.
  const INPUT = ["pointermove", "pointerdown", "wheel", "scroll", "keydown"];
  let started = false;
  const start = () => {
    if (started) return;
    started = true;
    for (const e of INPUT) removeEventListener(e, start);
    void import("../ui/landing.ts").then((m) => m.startLanding());
  };
  const arm = () => {
    for (const e of INPUT) addEventListener(e, start, { passive: true });
    setTimeout(start, 3000);
  };
  if (document.readyState === "complete") arm(); else addEventListener("load", arm, { once: true });
</script>
